# ==========================================================
# EconoFácil - Backend | Variáveis de Ambiente (exemplo)
# Copie para .env e preencha. NUNCA versione o .env real.
# ==========================================================

# Aplicação
PROJECT_NAME="EconoFácil API"
ENVIRONMENT="development"   # development | staging | production
API_V1_STR="/api/v1"
DEBUG=true

# Segurança
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY="troque-este-valor-em-producao"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
EMAIL_TOKEN_EXPIRE_MINUTES=60

# CORS (origens do frontend separadas por vírgula)
BACKEND_CORS_ORIGINS="http://localhost:5173,http://localhost:3000"

# Banco de dados (PostgreSQL via asyncpg)
DATABASE_URL="postgresql+asyncpg://econofacil:econofacil@localhost:5432/econofacil"

# 2FA / TOTP
TOTP_ISSUER="EconoFácil"

# Noor — motor de otimização de cestas
NOOR_SOLVER_ENABLED=true     # usa o solver ILP (CBC) quando disponível
NOOR_FORCE_HEURISTIC=false    # força a heurística (para comparação/diagnóstico)

# Pagamentos PIX
PIX_KEY="pagamentos@econofacil.com.br"   # chave Pix recebedora (plataforma)
PIX_CHARGE_TTL_SECONDS=3600
PIX_WEBHOOK_SECRET="troque-este-segredo"  # valida o callback do PSP

# LGPD
TERMS_VERSION="2025.1"
